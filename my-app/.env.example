# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string
# Local Docker Compose: postgresql://postgres:postgrespassword@localhost:5432/ournepal_db
# Production Neon: postgresql://user:password@ep-host.neon.tech/ournepal_db?sslmode=require
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/ournepal_db

# ==========================================
# Authentication & Security
# ==========================================
# Secret key used to sign JWT tokens (minimum 32 characters required)
JWT_SECRET=replace-with-output-of-openssl-rand-base64-48

# ==========================================
# Cloudinary Media Configuration
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# Rate Limiting (Optional - Upstash Redis)
# ==========================================
# If omitted, local development falls back to an in-memory sliding window limiter
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
