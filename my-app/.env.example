# ==========================================
# Database Configuration
# ==========================================
# PostgreSQL connection string (Neon in production, Docker Compose locally)
# Example local: postgresql://postgres:postgrespassword@localhost:5432/ournepal_db
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ==========================================
# Authentication & Security
# ==========================================
# Secret key used to sign JWT tokens (minimum 32 characters required)
JWT_SECRET=your-minimum-32-character-jwt-secret-string-here

# Comma-separated list of admin email addresses auto-granted admin privileges
ADMIN_EMAILS=admin@example.com

# ==========================================
# Cloudinary Media Configuration
# ==========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ==========================================
# Rate Limiting (Optional - Upstash Redis)
# ==========================================
# If omitted, local development falls back to an in-memory sliding window limiter
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
